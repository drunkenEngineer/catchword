{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "All the interface may do: hear that the status changed, and call Catchword's own commands. No file system, shell, window or network access (SEC-1).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-status",
    "allow-search",
    "allow-add-folder",
    "allow-remove-folder",
    "allow-index-now",
    "allow-retry-failed",
    "allow-preview",
    "allow-open-file",
    "allow-reveal-file"
  ]
}
